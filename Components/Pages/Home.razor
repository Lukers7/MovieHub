@page "/"

@using MovieHub.Models

<PageTitle>Home</PageTitle>

<h1>Filme</h1>

<p class="text-muted mb-4">
    Eine kleine Beispiel-Liste als Startpunkt.
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th scope="col">Titel</th>
                <th scope="col" class="text-nowrap">Jahr</th>
                <th scope="col">Genre</th>
                <th scope="col">Regie</th>
                <th scope="col" class="text-nowrap">Länge</th>
                <th scope="col" class="text-nowrap">Rating</th>
                <th scope="col">Notizen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Movies)
            {
                <tr>
                    <td class="fw-semibold">@movie.Title</td>
                    <td class="text-nowrap">@movie.Year</td>
                    <td>@movie.Genre</td>
                    <td>@movie.Director</td>
                    <td class="text-nowrap">@movie.RuntimeMinutes&nbsp;min</td>
                    <td class="text-nowrap">@movie.Rating.ToString("0.0")</td>
                    <td class="text-muted">@movie.Notes</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static readonly Movie[] Movies =
    [
        new("The Matrix", 1999, "Sci‑Fi/Action", "Lana & Lilly Wachowski", 136, 8.7m, "Klassiker der 90er"),
        new("Inception", 2010, "Sci‑Fi/Thriller", "Christopher Nolan", 148, 8.8m, "Mind‑bender"),
        new("Parasite", 2019, "Drama/Thriller", "Bong Joon-ho", 132, 8.5m, "Oscars 2020"),
        new("Spirited Away", 2001, "Animation/Fantasy", "Hayao Miyazaki", 125, 8.6m, "Studio Ghibli"),
        new("Interstellar", 2014, "Sci‑Fi/Drama", "Christopher Nolan", 169, 8.7m, "Episch & emotional"),
    ];
}

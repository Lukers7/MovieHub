@page "/movies/{Id:int}"

@using MovieHub.Models

<PageTitle>Movie Details</PageTitle>

<h1>Film-Details</h1>

@if (EditModel is null)
{
    <div class="alert alert-warning" role="alert">
        Film mit Id @Id nicht gefunden.
    </div>
    <a class="btn btn-sm btn-secondary" href="/">Zurück</a>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h4 mb-3">Bearbeiten (noch ohne Speichern)</h2>

            <EditForm Model="EditModel">
                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label class="form-label">Titel</label>
                        <InputText class="form-control" @bind-Value="EditModel.Title" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Jahr</label>
                        <InputNumber class="form-control" @bind-Value="EditModel.Year" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Genre</label>
                        <InputText class="form-control" @bind-Value="EditModel.Genre" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Regie</label>
                        <InputText class="form-control" @bind-Value="EditModel.Director" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Länge (min)</label>
                        <InputNumber class="form-control" @bind-Value="EditModel.RuntimeMinutes" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Rating</label>
                        <InputNumber class="form-control" @bind-Value="EditModel.Rating" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notizen</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="EditModel.Notes" />
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="card-footer bg-white">
            <a class="btn btn-sm btn-outline-secondary" href="/">Zurück</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MovieEditModel? EditModel { get; set; }

    protected override void OnParametersSet()
    {
        var movie = Movies.FirstOrDefault(m => m.Id == Id);
        EditModel = movie is null ? null : new MovieEditModel(movie);
    }

    private static readonly Movie[] Movies =
    [
        new(1, "The Matrix", 1999, "Sci‑Fi/Action", "Lana & Lilly Wachowski", 136, 8.7m, "Klassiker der 90er"),
        new(2, "Inception", 2010, "Sci‑Fi/Thriller", "Christopher Nolan", 148, 8.8m, "Mind‑bender"),
        new(3, "Parasite", 2019, "Drama/Thriller", "Bong Joon-ho", 132, 8.5m, "Oscars 2020"),
        new(4, "Spirited Away", 2001, "Animation/Fantasy", "Hayao Miyazaki", 125, 8.6m, "Studio Ghibli"),
        new(5, "Interstellar", 2014, "Sci‑Fi/Drama", "Christopher Nolan", 169, 8.7m, "Episch & emotional"),
    ];

    private sealed class MovieEditModel
    {
        public MovieEditModel()
        {
        }

        public MovieEditModel(Movie movie)
        {
            Title = movie.Title;
            Year = movie.Year;
            Genre = movie.Genre;
            Director = movie.Director;
            RuntimeMinutes = movie.RuntimeMinutes;
            Rating = movie.Rating;
            Notes = movie.Notes;
        }

        public string Title { get; set; } = "";
        public int Year { get; set; }
        public string Genre { get; set; } = "";
        public string Director { get; set; } = "";
        public int RuntimeMinutes { get; set; }
        public decimal Rating { get; set; }
        public string Notes { get; set; } = "";
    }
}
